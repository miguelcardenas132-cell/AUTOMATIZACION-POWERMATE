  FUENTE_MONTSERRAT: 'data:font/woff2;base64,',
  LOGO_HEADER: 'data:image/png;base64,',
  QR_COTIZAR: 'data:image/png;base64,',
  LOGO_FOOTER: 'data:image/png;base64,'
};
